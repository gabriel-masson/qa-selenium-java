<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.qa</groupId>
    <artifactId>automationexercise-qa-suite</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Automation Exercise QA Suite</name>
    <description>
        Projeto de automação de testes (API, Integração e E2E) para automationexercise.com,
        com Java, Selenium, JUnit 5 e Maven.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versões das dependências centralizadas aqui -->
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <selenium.version>4.21.0</selenium.version>
        <webdrivermanager.version>5.8.0</webdrivermanager.version>
        <restassured.version>5.4.0</restassured.version>
        <jackson.version>2.17.1</jackson.version>
        <slf4j.version>2.0.13</slf4j.version>
        <surefire.version>3.2.5</surefire.version>
        <allure.version>2.29.0</allure.version>
        <allure.maven.version>2.12.0</allure.maven.version>

        <!-- Ambiente padrão caso nenhum profile seja explicitamente ativado -->
        <env>dev</env>
        <!-- Filtro de tags padrão (fallback) - cada profile sobrescreve este valor -->
        <test.groups></test.groups>
        <!-- Tags excluídas por padrão em qualquer execução normal. "flaky" fica
             de fora do pipeline principal por padrão - ver profile "quarantine". -->
        <test.excludedGroups>flaky</test.excludedGroups>
    </properties>

    <dependencies>
        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Selenium WebDriver -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Gerenciamento automático de drivers de browser -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- RestAssured para testes de API -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <!-- Jackson para (de)serialização de modelos JSON da API -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Allure: gera relatório HTML interativo a partir da execução dos testes -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>automationexercise-qa-suite</finalName>
        <plugins>
            <!-- Compilador -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Executor dos testes JUnit 5. Essencial para o CI/CD. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- Propaga o profile de ambiente ativo para dentro da JVM de teste -->
                    <systemPropertyVariables>
                        <env>${env}</env>
                    </systemPropertyVariables>
                    <!-- Filtra quais testes rodam, com base na tag definida pelo profile ativo.
                         Vazio ("") significa "sem filtro" - roda tudo. -->
                    <groups>${test.groups}</groups>
                    <!-- Testes marcados como "flaky" (quarentena) ficam de fora da
                         execução normal do pipeline, por padrão. -->
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <!-- Rede de segurança contra instabilidade genuína de ambiente
                         (ex: rede lenta, timing de terceiros). Um teste que falhar
                         é executado novamente até 2 vezes antes de ser marcado como
                         falho de verdade. NÃO substitui corrigir bugs reais de
                         locator/lógica - serve só para o que está genuinamente
                         fora do nosso controle. -->
                    <rerunFailingTestsCount>2</rerunFailingTestsCount>
                    <!-- Convenção de nomes que o Surefire reconhece por padrão:
                         *Test.java, *Tests.java, Test*.java -->
                </configuration>
            </plugin>

            <!-- Gera o relatório HTML interativo do Allure a partir dos resultados
                 de execução (target/allure-results). Uso: mvn allure:report ou
                 mvn allure:serve (abre automaticamente no navegador). -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.version}</version>
            </plugin>
        </plugins>
    </build>

    <!--
        Profiles de ambiente.
        Ativados via: mvn test -Pdev | -Pstaging | -Pprod
        A propriedade "env" é lida em tempo de execução pela classe
        com.qa.automationexercise.config.ConfigManager, que carrega o
        arquivo <env>.properties correspondente.

        A propriedade "test.groups" implementa a estratégia de execução por
        gatilho definida no Test Plan (Etapa 1, seção 8):
          - dev (push):     só testes "smoke" -> feedback rápido
          - staging (PR):   sem filtro -> suíte completa (smoke + regression)
          - prod (merge):   só testes "smoke" -> validação crítica pós-deploy
    -->
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <env>dev</env>
                <test.groups>smoke</test.groups>
            </properties>
        </profile>
        <profile>
            <id>staging</id>
            <properties>
                <env>staging</env>
                <test.groups></test.groups>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <env>prod</env>
                <test.groups>smoke</test.groups>
            </properties>
        </profile>

        <!--
            Profile de quarentena: roda APENAS os testes marcados @Tag("flaky"),
            de forma isolada. Usado para monitorar a saúde de testes conhecidamente
            instáveis (ex: causados por interferência de terceiros que não temos
            como eliminar 100%) sem que eles bloqueiem o pipeline principal.
            Uso: mvn test -Pquarantine
        -->
        <profile>
            <id>quarantine</id>
            <properties>
                <env>staging</env>
                <test.groups>flaky</test.groups>
                <test.excludedGroups></test.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>